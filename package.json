{
  "name": "pigeonslip",
  "version": "0.1.0",
  "private": true,
  "description": "A free desktop app that prints shipping labels at the standard 4 x 6 in size, as many per sheet as fit. Drop in label PDFs or pictures, check the preview, print.",
  "license": "MIT",
  "author": "Matthew Pitts",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "smoke": "node scripts/start.js --smoke",
    "test": "vitest run",
    "icon": "node scripts/build-icon.cjs",
    "dist": "electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vitest": "5.1.1"
  },
  "build": {
    "appId": "app.pigeonslip",
    "productName": "Pigeonslip",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pigeonslip",
      "artifactName": "Pigeonslip-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Pigeonslip-Portable.${ext}"
    }
  }
}
