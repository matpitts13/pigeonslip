// The website in site/ (not the desktop app). Deploy with: npx wrangler@4.160.0 deploy (4.165.0 fails creating new Workers)
// Static files only, on Cloudflare Workers' free plan.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pigeonslip",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "site" },
  "routes": [{ "pattern": "pigeonslip.ravenburst.com", "custom_domain": true }]
}
